{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.map",
  "name": "pocket-map",
  "title": "Pocket Map",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "io.offload",
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "input.analog.left"
      ]
    }
  },
  "app": {
    "entry": "app/psp.tsx",
    "output": "pocketmap-psp",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "native"
      }
    }
  }
}
